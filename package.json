{
  "name": "pixel-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "sheet": "tsx scripts/sheet.ts sheets 5",
    "icons": "tsx scripts/icons.ts",
    "gear": "tsx scripts/gear.ts gear.png 4",
    "trees": "tsx scripts/trees.ts trees.png 3",
    "forest": "tsx scripts/forest.ts forest.png",
    "stag": "tsx scripts/stag.ts stag.png 4",
    "wildlife": "tsx scripts/wildlife.ts wildlife.png 5",
    "modes": "tsx scripts/modes.ts modes.png 3"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
